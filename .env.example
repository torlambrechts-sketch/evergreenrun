# Evergreen Run — environment template. Copy to .env.local and fill in.
# Never commit .env.local (it is gitignored).

# Supabase project "Evergreenrun" (EU, eu-west-1)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only. Bypasses RLS — never expose to the client, never log it.
# Only used by the RLS integration test to seed/tear down test users.
SUPABASE_SERVICE_ROLE_KEY=
